rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin authority is granted only when a trusted server/Admin SDK has set
    // the Firebase Auth custom claim and provisioned the matching protected
    // user profile. Neither value can be assigned by public registration.
    function isTrustedAdmin() {
      return request.auth != null
             && request.auth.token.keys().hasAll(['admin'])
             && request.auth.token.admin == true
             && exists(
               /databases/$(database)/documents/users/$(request.auth.uid)
             )
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.userId == request.auth.uid
             && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'admin';
    }

    function hasExactKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function validGrade(data, gradeId) {
      return hasExactKeys(data, ['gradeId', 'name', 'order', 'isActive'])
             && data.gradeId == gradeId
             && isNonEmptyString(data.gradeId)
             && isNonEmptyString(data.name)
             && data.order is int
             && data.isActive is bool;
    }

    function validSubject(data, subjectId) {
      return hasExactKeys(
               data,
               ['subjectId', 'name', 'gradeId', 'imageUrl', 'order', 'isActive']
             )
             && data.subjectId == subjectId
             && isNonEmptyString(data.subjectId)
             && isNonEmptyString(data.name)
             && isNonEmptyString(data.gradeId)
             && data.imageUrl is string
             && data.order is int
             && data.isActive is bool
             && exists(
               /databases/$(database)/documents/grades/$(data.gradeId)
             );
    }

    function validChapter(data, chapterId) {
      return hasExactKeys(
               data,
               ['chapterId', 'title', 'subjectId', 'order', 'isActive']
             )
             && data.chapterId == chapterId
             && isNonEmptyString(data.chapterId)
             && isNonEmptyString(data.title)
             && isNonEmptyString(data.subjectId)
             && data.order is int
             && data.isActive is bool
             && exists(
               /databases/$(database)/documents/subjects/$(data.subjectId)
             );
    }

    function validLesson(data, lessonId) {
      return hasExactKeys(
               data,
               [
                 'lessonId',
                 'title',
                 'chapterId',
                 'explanation',
                 'order',
                 'isActive',
                 'createdAt',
                 'updatedAt'
               ]
             )
             && data.lessonId == lessonId
             && isNonEmptyString(data.lessonId)
             && isNonEmptyString(data.title)
             && isNonEmptyString(data.chapterId)
             && isNonEmptyString(data.explanation)
             && data.order is int
             && data.isActive is bool
             && data.createdAt is timestamp
             && data.updatedAt is timestamp
             && exists(
               /databases/$(database)/documents/chapters/$(data.chapterId)
             );
    }

    function validQuestion(data, questionId) {
      return hasExactKeys(
               data,
               [
                 'questionId',
                 'lessonId',
                 'questionText',
                 'options',
                 'correctAnswerIndex',
                 'explanation',
                 'order',
                 'isActive'
               ]
             )
             && data.questionId == questionId
             && isNonEmptyString(data.questionId)
             && isNonEmptyString(data.lessonId)
             && isNonEmptyString(data.questionText)
             && data.options is list
             && data.options.size() > 0
             && data.correctAnswerIndex is int
             && data.correctAnswerIndex >= 0
             && data.correctAnswerIndex < data.options.size()
             && isNonEmptyString(data.explanation)
             && data.order is int
             && data.isActive is bool
             && exists(
               /databases/$(database)/documents/lessons/$(data.lessonId)
             );
    }

    function validResource(data, resourceId) {
      return hasExactKeys(
               data,
               [
                 'resourceId',
                 'lessonId',
                 'title',
                 'type',
                 'url',
                 'storagePath',
                 'order',
                 'isActive',
                 'createdAt'
               ]
             )
             && data.resourceId == resourceId
             && isNonEmptyString(data.resourceId)
             && isNonEmptyString(data.lessonId)
             && isNonEmptyString(data.title)
             && (data.type == 'video' || data.type == 'pdf')
             && data.url is string
             && isNonEmptyString(data.storagePath)
             && data.order is int
             && data.isActive is bool
             && data.createdAt is timestamp
             && exists(
               /databases/$(database)/documents/lessons/$(data.lessonId)
             );
    }

    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                      'userId',
                      'name',
                      'email',
                      'role',
                      'gradeId',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'userId',
                      'name',
                      'email',
                      'role',
                      'gradeId',
                      'createdAt'
                    ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == 'student'
                    && request.resource.data.gradeId == null
                    && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.userId == request.auth.uid
                    && resource.data.role == 'student'
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['gradeId'])
                    && resource.data.gradeId == null
                    && request.resource.data.gradeId is string
                    && request.resource.data.gradeId.size() > 0
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.name == resource.data.name
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt
                    && exists(
                      /databases/$(database)/documents/grades/$(request.resource.data.gradeId)
                    )
                    && get(
                      /databases/$(database)/documents/grades/$(request.resource.data.gradeId)
                    ).data.isActive == true;

      allow delete: if false;
    }

    match /grades/{gradeId} {
      allow read: if isTrustedAdmin()
                  || (request.auth != null
                      && resource.data.isActive == true);

      allow create: if isTrustedAdmin()
                    && validGrade(request.resource.data, gradeId);
      allow update: if isTrustedAdmin()
                    && validGrade(request.resource.data, gradeId);
      // Hard-delete semantics are not defined by the approved design.
      allow delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if isTrustedAdmin()
                  || (request.auth != null
                      && resource.data.isActive == true
                      && exists(
                        /databases/$(database)/documents/users/$(request.auth.uid)
                      )
                      && get(
                        /databases/$(database)/documents/users/$(request.auth.uid)
                      ).data.gradeId == resource.data.gradeId);

      allow create: if isTrustedAdmin()
                    && validSubject(request.resource.data, subjectId);
      allow update: if isTrustedAdmin()
                    && validSubject(request.resource.data, subjectId);
      allow delete: if false;
    }

    match /chapters/{chapterId} {
      allow read: if isTrustedAdmin()
                  || (request.auth != null
                      && resource.data.isActive == true
                      && resource.data.subjectId is string
                      && exists(
                        /databases/$(database)/documents/users/$(request.auth.uid)
                      )
                      && exists(
                        /databases/$(database)/documents/subjects/$(resource.data.subjectId)
                      )
                      && get(
                        /databases/$(database)/documents/subjects/$(resource.data.subjectId)
                      ).data.isActive == true
                      && get(
                        /databases/$(database)/documents/subjects/$(resource.data.subjectId)
                      ).data.gradeId == get(
                        /databases/$(database)/documents/users/$(request.auth.uid)
                      ).data.gradeId);

      allow create: if isTrustedAdmin()
                    && validChapter(request.resource.data, chapterId);
      allow update: if isTrustedAdmin()
                    && validChapter(request.resource.data, chapterId);
      allow delete: if false;
    }

    match /lessons/{lessonId} {
      allow read: if isTrustedAdmin()
                  || (request.auth != null
                  && resource.data.isActive == true
                  && resource.data.chapterId is string
                  && exists(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  )
                  && exists(
                    /databases/$(database)/documents/chapters/$(resource.data.chapterId)
                  )
                  && get(
                    /databases/$(database)/documents/chapters/$(resource.data.chapterId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/chapters/$(resource.data.chapterId)
                  ).data.subjectId is string
                  && exists(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(resource.data.chapterId)
                    ).data.subjectId)
                  )
                  && get(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(resource.data.chapterId)
                    ).data.subjectId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(resource.data.chapterId)
                    ).data.subjectId)
                  ).data.gradeId == get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  ).data.gradeId);

      allow create: if isTrustedAdmin()
                    && validLesson(request.resource.data, lessonId)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isTrustedAdmin()
                    && validLesson(request.resource.data, lessonId)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if isTrustedAdmin()
                  || (request.auth != null
                  && resource.data.isActive == true
                  && resource.data.lessonId is string
                  && exists(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  )
                  && exists(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  )
                  && get(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  ).data.chapterId is string
                  && exists(
                    /databases/$(database)/documents/chapters/$(get(
                      /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                    ).data.chapterId)
                  )
                  && get(
                    /databases/$(database)/documents/chapters/$(get(
                      /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                    ).data.chapterId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/chapters/$(get(
                      /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                    ).data.chapterId)
                  ).data.subjectId is string
                  && exists(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId)
                  )
                  && get(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId)
                  ).data.gradeId == get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  ).data.gradeId);

      allow create: if isTrustedAdmin()
                    && validResource(request.resource.data, resourceId)
                    && request.resource.data.createdAt == request.time;
      allow update: if isTrustedAdmin()
                    && validResource(request.resource.data, resourceId)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /questions/{questionId} {
      allow read: if isTrustedAdmin()
                  || (request.auth != null
                  && resource.data.isActive == true
                  && resource.data.lessonId is string
                  && exists(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  )
                  && get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  ).data.userId == request.auth.uid
                  && get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  ).data.role == 'student'
                  && exists(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  )
                  && get(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  ).data.lessonId == resource.data.lessonId
                  && get(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                  ).data.chapterId is string
                  && exists(
                    /databases/$(database)/documents/chapters/$(get(
                      /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                    ).data.chapterId)
                  )
                  && get(
                    /databases/$(database)/documents/chapters/$(get(
                      /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                    ).data.chapterId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/chapters/$(get(
                      /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                    ).data.chapterId)
                  ).data.subjectId is string
                  && exists(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId)
                  )
                  && get(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId)
                  ).data.isActive == true
                  && get(
                    /databases/$(database)/documents/subjects/$(get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId)
                  ).data.gradeId == get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                  ).data.gradeId);

      allow create: if isTrustedAdmin()
                    && validQuestion(request.resource.data, questionId);
      allow update: if isTrustedAdmin()
                    && validQuestion(request.resource.data, questionId);
      allow delete: if false;
    }

    match /quizAttempts/{attemptId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'attemptId',
                      'userId',
                      'lessonId',
                      'score',
                      'totalQuestions',
                      'percentage',
                      'completedAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'attemptId',
                      'userId',
                      'lessonId',
                      'score',
                      'totalQuestions',
                      'percentage',
                      'completedAt'
                    ])
                    && attemptId == request.resource.data.attemptId
                    && request.resource.data.attemptId is string
                    && request.resource.data.attemptId.size() > 0
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.lessonId is string
                    && request.resource.data.lessonId.size() > 0
                    && request.resource.data.score is int
                    && request.resource.data.totalQuestions is int
                    && request.resource.data.totalQuestions > 0
                    && request.resource.data.score >= 0
                    && request.resource.data.score
                       <= request.resource.data.totalQuestions
                    && request.resource.data.percentage is number
                    && request.resource.data.percentage >= 0
                    && request.resource.data.percentage <= 100
                    && request.resource.data.percentage
                       == request.resource.data.score * 100
                          / request.resource.data.totalQuestions
                    && request.resource.data.completedAt == request.time
                    && exists(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    )
                    && get(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.userId == request.auth.uid
                    && get(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.role == 'student'
                    && exists(
                      /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                    )
                    && get(
                      /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                    ).data.lessonId == request.resource.data.lessonId
                    && get(
                      /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                    ).data.isActive == true
                    && get(
                      /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                    ).data.chapterId is string
                    && exists(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                      ).data.chapterId)
                    )
                    && get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                      ).data.chapterId)
                    ).data.isActive == true
                    && get(
                      /databases/$(database)/documents/chapters/$(get(
                        /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                      ).data.chapterId)
                    ).data.subjectId is string
                    && exists(
                      /databases/$(database)/documents/subjects/$(get(
                        /databases/$(database)/documents/chapters/$(get(
                          /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                        ).data.chapterId)
                      ).data.subjectId)
                    )
                    && get(
                      /databases/$(database)/documents/subjects/$(get(
                        /databases/$(database)/documents/chapters/$(get(
                          /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                        ).data.chapterId)
                      ).data.subjectId)
                    ).data.isActive == true
                    && get(
                      /databases/$(database)/documents/subjects/$(get(
                        /databases/$(database)/documents/chapters/$(get(
                          /databases/$(database)/documents/lessons/$(request.resource.data.lessonId)
                        ).data.chapterId)
                      ).data.subjectId)
                    ).data.gradeId == get(
                      /databases/$(database)/documents/users/$(request.auth.uid)
                    ).data.gradeId;

      // Attempts are append-only records; client updates and deletes are denied.
      allow update, delete: if false;
    }

    // Collections not implemented yet remain closed in Production mode.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
